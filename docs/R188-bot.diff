+  assert.equal(await M.tryMensaje(m("/spotify"), ctx), true);
+  assert.deepEqual(botones(enviados.at(-1)).map((b) => b.text), ["1. Crear familia", "2. Agregar invitado", "3. Vincular existente", "4. Consultar familia"]);
