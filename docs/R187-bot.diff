-function scoreMatch(value = "", query = "") {
-  const v = normalizeLooseText(value);
-  const q = normalizeLooseText(query);
-  if (!v || !q) return 0;
-  if (v === q) return 100;
-  if (v.startsWith(q)) return 80;
-  if (v.includes(q)) return 50;
-  return 0;
-}
