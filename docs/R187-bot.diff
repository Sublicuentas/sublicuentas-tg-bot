-async function getInventarioRowsByPlataforma(plataforma = "") {
-  const plat = normalizarPlataforma(plataforma);
-  let rows = [];
-
-  try {
-    const snap = await db.collection("inventario").where("plataforma", "==", plat).get();
-    rows = snap.docs.map((d) => ({ id: d.id, ...(d.data() || {}) }));
-  } catch (e) {
-    logErr("getInventarioRowsByPlataforma.where", e);
-  }
-
-  if (!rows.length) {
-    try {
-      const snapAll = await require("./index_30_espejo_firestore").getColeccion("inventario");
-      rows = snapAll.docs
-        .map((d) => ({ id: d.id, ...(d.data() || {}) }))
-        .filter((r) => normalizarPlataforma(r.plataforma || "") === plat);
-    } catch (e) {
-      logErr("getInventarioRowsByPlataforma.fallback", e);
-      rows = [];
-    }
-  }
-
-  // Cuenta más vacía primero: menor % de ocupación; empate → más libres; llenas al final.
-  rows.sort((a, b) => {
-    const ca = Math.max(1, getCapacidadCorreo(a, plat)), cb = Math.max(1, getCapacidadCorreo(b, plat));
-    const la = getDisponibles(a, plat), lb = getDisponibles(b, plat);
-    if ((la > 0) !== (lb > 0)) return la > 0 ? -1 : 1;
-    const pa = getOcupados(a) / ca, pb = getOcupados(b) / cb;
-    if (pa !== pb) return pa - pb;
-    if (lb !== la) return lb - la;
-    return getStoredIdent(a).localeCompare(getStoredIdent(b), "es", { sensitivity: "base" });
-  });
-
-  return rows;
-}
